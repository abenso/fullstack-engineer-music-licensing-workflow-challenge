  "query": "\n        SELECT\n            t.id, t.start_time_ms, t.end_time_ms, t.updated_at,\n            t.license_status AS \"license_status: LicenseStatus\",\n            s.id AS song_id, s.title AS song_title, s.artist AS song_artist\n        FROM tracks t\n        JOIN songs s ON s.id = t.song_id\n        WHERE t.id = $1\n        ",
